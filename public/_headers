# Baseline security headers for every static asset (including prerendered HTML).
# Worker responses (worker.ts) set the same headers in src/worker/http.ts.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Caching for files served by Workers Static Assets (the whole static export).

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/icons/extensions/*
  Cache-Control: public, max-age=31536000, immutable

# Stable filenames that get replaced in place, so they must expire.
/gifs/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/textures/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/glass/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/store-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Static-export files without an extension, so their type is set here.
/opengraph-image
  Content-Type: image/png

/twitter-image
  Content-Type: image/png

/api/v1/stars
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
