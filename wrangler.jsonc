{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openclip-web",
  // Wraps .open-next/worker.js; see worker.ts.
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    // Node.js API surface, required by the Next.js server runtime.
    "nodejs_compat",
    // Cache API / fetch behave like the public internet rather than the Worker itself.
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Static assets (and public/_redirects) are matched before the Worker runs, so
    // they use no Worker CPU.
    "run_worker_first": false,
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "openclip-web",
    },
  ],
  "routes": [{ "pattern": "www.getopenclip.app", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
  // Workers Cache: Cloudflare answers repeat requests from cache before the Worker
  // runs, honouring each response's Cache-Control. Keys are path + query and the
  // Worker version, so every deploy starts from a fresh cache. Note: on the Free plan
  // cache hits (including static assets) count toward the 100k requests/day.
  "cache": { "enabled": true },
  // Lets Workers Builds create preview deployments for pull requests, reachable at
  // <preview>-openclip-web.<subdomain>.workers.dev. Production stays off workers.dev.
  "previews": {},
  "workers_dev": false,
  "preview_urls": true,
}
