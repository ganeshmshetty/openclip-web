{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openclip-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    // Node.js API surface, required by the Next.js server runtime.
    "nodejs_compat",
    // Cache API / fetch behave like the public internet rather than the Worker itself.
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Static assets are matched before the Worker runs, so they are not billed.
    "run_worker_first": false,
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "openclip-web",
    },
  ],
  "routes": [{ "pattern": "www.getopenclip.app", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
}
