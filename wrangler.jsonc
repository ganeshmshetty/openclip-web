{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openclip-web",
  // Only the dynamic routes; everything else is the static export in out/. See worker.ts.
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    // Node.js API surface (process.env etc.).
    "nodejs_compat",
    // Cache API / fetch behave like the public internet rather than the Worker itself.
    "global_fetch_strictly_public",
  ],
  "assets": {
    // `next build` static export (output: "export" in next.config.ts).
    "directory": "out",
    "binding": "ASSETS",
    // Everything is served by Static Assets (with public/_redirects and
    // public/_headers) without running the Worker, except these dynamic routes. They
    // must be listed: with not_found_handling set, a browser navigation to a path
    // with no file would otherwise get the 404 page instead of the Worker.
    "run_worker_first": ["/api/*", "!/api/v1/stars", "/download"],
    // /extensions -> extensions.html; /extensions/ redirects (307) to /extensions.
    "html_handling": "drop-trailing-slash",
    // Unknown paths get out/404.html with a 404, without invoking the Worker.
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "www.getopenclip.app", "custom_domain": true }],
  // Exposes the Worker version id; worker.ts adds it to Cache API keys so a deploy
  // never serves the previous deploy's cached /api/v1/extensions responses.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true,
  },
  // Workers Cache: Cloudflare answers repeat requests from cache before the Worker
  // runs, honouring each response's Cache-Control. Keys are path + query and the
  // Worker version, so every deploy starts from a fresh cache.
  "cache": { "enabled": true },
  // Lets Workers Builds create preview deployments for pull requests, reachable at
  // <preview>-openclip-web.<subdomain>.workers.dev. Production stays off workers.dev.
  "previews": {},
  "workers_dev": false,
  "preview_urls": true,
}
