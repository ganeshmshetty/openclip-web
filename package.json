{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "predev": "bun run scripts/convert-gifs.ts && bun run scripts/sync-docs.ts && bun run scripts/build-docs-meta.ts && bun run scripts/sync-extensions.ts && bun run scripts/sync-changelog.ts && bun run scripts/sync-stars.ts && bun run scripts/render-diagrams.ts",
    "dev": "next dev",
    "prebuild:next": "bun run scripts/convert-gifs.ts && bun run scripts/sync-docs.ts && bun run scripts/build-docs-meta.ts && bun run scripts/sync-extensions.ts && bun run scripts/sync-changelog.ts && bun run scripts/sync-stars.ts && bun run scripts/render-diagrams.ts",
    "sync-docs": "bun run scripts/sync-docs.ts",
    "sync-extensions": "bun run scripts/sync-extensions.ts",
    "sync-changelog": "bun run scripts/sync-changelog.ts",
    "sync-stars": "bun run scripts/sync-stars.ts",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build --webpack",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "render-diagrams": "bun run scripts/render-diagrams.ts",
    "build-docs-meta": "bun run scripts/build-docs-meta.ts",
    "analyze": "ANALYZE=true bun run build:next",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@types/marked": "^6.0.0",
    "@types/prismjs": "^1.26.6",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.11",
    "motion": "^13.1.0",
    "next": "16.4.5",
    "pele": "^1.6.0",
    "prismjs": "^1.30.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.158.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
